set -eu
umask 077

. @SYSCONFDIR@/hostapd-apup/hostapd-apup.conf

HOSTAPD_CONFIG=/tmp/hostapup_apup.conf
NAT_CHAIN=APUP_MESH_NAT
PRIMARY_IF=primary0

cleanup_nat() {
    [ -n "${HOTSPOT_IP:-}" ] || return 0
    if iptables -t nat -S "$NAT_CHAIN" >/dev/null 2>&1; then
        iptables -t nat -D POSTROUTING -j "$NAT_CHAIN" 2>/dev/null || true
        iptables -t nat -F "$NAT_CHAIN"
        iptables -t nat -X "$NAT_CHAIN"
    fi
}

load_addresses() {
    PHY_MAC=$(cat "/sys/class/net/$WIFI_IF/address")
    BAT_MAC="42:${PHY_MAC#*:}"
    PRIMARY_MAC="46:${PHY_MAC#*:}"
    if [ -z "${NODE_IP:-}" ]; then
        MAC5=$(printf '%s\n' "$PHY_MAC" | cut -d: -f5)
        MAC6=$(printf '%s\n' "$PHY_MAC" | cut -d: -f6)
        NODE_IP="$NET_PREFIX.$(printf '%d' "0x$MAC5").$(printf '%d' "0x$MAC6")"
    fi
}

prepare() {
    attempts=0
    while [ ! -e "/sys/class/net/$WIFI_IF/address" ]; do
        if [ "$attempts" -ge 360 ]; then
            echo "Wi-Fi interface $WIFI_IF not found after 360 seconds" >&2
            exit 1
        fi
        sleep 1
        attempts=$((attempts + 1))
    done
    load_addresses
    rfkill unblock all
    ip link set "$WIFI_IF" down
    sleep 1
    iw reg set "$COUNTRY_CODE"
    sleep 1
    iw dev "$WIFI_IF" set txpower $TX_POWER
    sleep 1
    iw dev "$WIFI_IF" set type __ap
    ip link set "$WIFI_IF" mtu 1500
    if [ -n "${HOTSPOT_IP:-}" ]; then
        ip addr replace "$HOTSPOT_CIDR" dev "$WIFI_IF"
    fi

    if [ ! -d /sys/module/batman_adv ]; then
        modprobe batman-adv
    fi
    if ! ip link show dev "$MESH_IF" >/dev/null 2>&1; then
        ip link add name "$MESH_IF" type batadv
    fi
    batctl meshif "$MESH_IF" bl 0
    batctl meshif "$MESH_IF" multicast_mode 0
    batctl meshif "$MESH_IF" it "$ORIG_INTERVAL"
    rfkill unblock all
    ip link set "$WIFI_IF" up
    ip link set "$MESH_IF" address "$BAT_MAC"
    ip link set "$MESH_IF" mtu 1460
    ip link set "$MESH_IF" up
    ip addr flush dev "$MESH_IF"
    ip addr replace "$NODE_IP/16" broadcast "$NET_PREFIX.255.255" dev "$MESH_IF"

    # Added first so it stays the primary: the originator address no longer depends on which peer shows up first
    if ! ip link show dev "$PRIMARY_IF" >/dev/null 2>&1; then
        ip link add name "$PRIMARY_IF" type dummy
    fi
    ip link set "$PRIMARY_IF" address "$PRIMARY_MAC"
    ip link set "$PRIMARY_IF" up
    if ! batctl meshif "$MESH_IF" if | awk -v iface="$PRIMARY_IF:" '$1 == iface {found=1} END {exit !found}'; then
        batctl meshif "$MESH_IF" if add "$PRIMARY_IF"
    fi

    if [ -n "${HOTSPOT_IP:-}" ]; then
        echo 1 > /proc/sys/net/ipv4/ip_forward
        cleanup_nat
        iptables -t nat -N "$NAT_CHAIN"
        iptables -t nat -A "$NAT_CHAIN" -s "$HOTSPOT_NETWORK" -o "$MESH_IF" -j MASQUERADE
        iptables -t nat -A POSTROUTING -j "$NAT_CHAIN"
    fi
    echo "Mesh prepared. Node IP: $NODE_IP - Bat MAC: $BAT_MAC"
}

generate_config() {
    DRIVER=$(basename "$(readlink "/sys/class/net/$WIFI_IF/device/driver")")
    HT40_DIRECTION="[HT40+]"
    if [ "$WIFI_CHANNEL" -gt 7 ]; then
        HT40_DIRECTION="[HT40-]"
    fi
    case "$DRIVER" in
        ath9k*|rt2800usb)
            HT_CAPAB="${HT40_DIRECTION}[SHORT-GI-20][SHORT-GI-40][RX-STBC1]"
            ;;
        *)
            HT_CAPAB="[SHORT-GI-20][SHORT-GI-40]"
            ;;
    esac

    cat <<EOF > "$HOSTAPD_CONFIG"
interface=$WIFI_IF
ctrl_interface=/var/run/hostapd
driver=nl80211
ssid=$SSID
channel=$WIFI_CHANNEL
hw_mode=g
ieee80211n=1
wmm_enabled=1
country_code=$COUNTRY_CODE
stationary_ap=0
ht_capab=$HT_CAPAB
preamble=1
apup=1
apup_peer_ifname_prefix=$APUPEER_PREFIX
auth_algs=1
EOF
    if [ -n "${STAWPA:-}" ]; then
    cat <<EOF >> "$HOSTAPD_CONFIG"
wpa=2
wpa_passphrase=$STAWPA
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
rsn_pairwise=CCMP
EOF
    fi
}

watch_peers() {
    set +e
    echo "Watcher started: waiting for ${APUPEER_PREFIX}X interfaces..."
    while true; do
        for sta_path in /sys/class/net/"$APUPEER_PREFIX"*; do
            [ -e "$sta_path" ] || continue
            sta_if=${sta_path##*/}
            PEER_NUM=${sta_if#"$APUPEER_PREFIX"}
            case "$PEER_NUM" in
                ''|*[!0-9]*) continue ;;
            esac
            MV_IF="mv${PEER_NUM}"
            if batctl meshif "$MESH_IF" if | awk -v iface="$MV_IF:" '$1 == iface {found=1} END {exit !found}'; then
                continue
            fi
            # Peer MAC on this WDS link; empty until hostapd has moved the station here, so retry on the next pass
            PEER_MAC=$(iw dev "$sta_if" station dump 2>/dev/null | awk '/^Station/ {print $2; exit}')
            [ -n "$PEER_MAC" ] || continue
            # 02 (locally administered) + our MAC bytes 4-6 + peer MAC bytes 5-6: unique per peer, stable across reboots
            MV_MAC="02:$(printf '%s\n' "$PHY_MAC" | cut -d: -f4-6):$(printf '%s\n' "$PEER_MAC" | cut -d: -f5-6)"
            if ! ip link show dev "$MV_IF" >/dev/null 2>&1; then
                echo "Creating $MV_IF on $sta_if with MAC $MV_MAC"
                ip link add link "$sta_if" name "$MV_IF" address "$MV_MAC" type macvlan mode bridge || continue
            fi
            ip link set dev "$MV_IF" up || continue
            batctl meshif "$MESH_IF" if add "$MV_IF"
        done
        sleep 2
    done
}

case "${1:-}" in
    prepare)
        prepare
        ;;
    start)
        load_addresses
        generate_config
        if [ -n "${HOTSPOT_IP:-}" ]; then
            dnsmasq --interface="$WIFI_IF" --except-interface=lo --bind-interfaces \
                --pid-file=/run/hostapd-apup/dnsmasq.pid \
                --dhcp-leasefile=/run/hostapd-apup/dnsmasq.leases \
                --dhcp-range="$DHCP_RANGE" \
                --dhcp-option="3,$HOTSPOT_IP" --dhcp-option="6,$HOTSPOT_IP" \
                --conf-file=/dev/null
        fi
        watch_peers &
        echo "Starting hostapd on channel $WIFI_CHANNEL"
        exec @SBINDIR@/hostapd "$HOSTAPD_CONFIG"
        ;;
    stop)
        cleanup_nat
        ;;
    *)
        echo "Usage: $0 {prepare|start|stop}" >&2
        exit 1
        ;;
esac
